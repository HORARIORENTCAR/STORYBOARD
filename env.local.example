# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings -> API, dentro del panel de Supabase).

# Pública, segura de compartir en el navegador:
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA — nunca debe llevar el prefijo NEXT_PUBLIC_, y nunca se sube a git.
# Solo se usa en el servidor (src/app/api/invite) para poder invitar personas.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Avisos al celular (notificaciones push) ---
# La pública también va en el navegador, por eso lleva NEXT_PUBLIC.
# La privada NUNCA debe llevar NEXT_PUBLIC: solo la usa el servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=pega-aqui-la-clave-publica
VAPID_PRIVATE_KEY=pega-aqui-la-clave-privada
VAPID_CONTACTO=mailto:tu-correo@colegio.edu.do
